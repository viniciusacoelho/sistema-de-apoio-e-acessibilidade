<div class="container-filters">

    <div class="card-neighborhood">
        <label for="neighborhood">Filtrar por Bairro</label>
        <select name="neighborhood" id="neighborhood">
            <option value="">Todos os bairros</option>
            <option value="Serraria">Serraria</option>
            <option value="Barro Duro">Barro Duro</option>
            <option value="Gruta">Gruta</option>
            <option value="Farol">Farol</option>
        </select>
    </div>

    <div class="card-date">
        <label for="dateFilter">Filtrar por Data</label>
        <input type="date" id="dateFilter">
    </div>

    <div class="card-rating">
        <label for="ratingFilter">Filtrar por Avaliação</label>
        <select id="ratingFilter">
            <option value="">Todas as avaliações</option>
            <option value="5">5 estrelas</option>
            <option value="4">4 estrelas</option>
            <option value="3">3 estrelas</option>
            <option value="2">2 estrelas</option>
            <option value="1">1 estrela</option>
        </select>
    </div>

</div>