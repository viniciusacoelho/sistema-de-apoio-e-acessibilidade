<% if (error) { %>
    <div class="alert error">
        <p><%= error %></p>
    </div>
<% } %> 
<% if (ok) { %>
    <div class="alert success">
        <p>Local cadastrado com sucesso!</p>
    </div>
<% } %> 
<div class="card-between">
    <div class="card-image">
        <input type="file" name="image" id="image" accept="image/*">
        <label for="image" class="image" tabindex="0">Escolher imagem<span class="right">*</span></label>
        <p id="file-name">Nenhum arquivo selecionado</p>
        <img id="preview" src="<%= values ? values.imagem : '' %>" alt="Preview">
    </div>
    <div class="card-right">
        <div class="card-name">
            <label for="name">Nome do Local<span class="right">*</span></label>
            <input type="text" name="name" id="name" placeholder="Digite o nome do local" value="<%=  values ? values.nome : '' %>">
        </div>
        
        <div class="card-neighborhood">
            <label for="neighborhood">Bairro<span class="right">*</span></label>
            <select name="neighborhood" id="neighborhood">
                <option value="" disabled <%= !values?.bairro ? 'selected' : '' %>>Selecione um bairro</option>
                <option value="Serraria" <%= values?.bairro === 'Serraria' ? 'selected' : '' %>>Serraria</option>
                <option value="Barro Duro" <%= values?.bairro === 'Barro Duro' ? 'selected' : '' %>>Barro Duro</option>
                <option value="Gruta" <%= values?.bairro === 'Gruta' ? 'selected' : '' %>>Gruta</option>
                <option value="Farol" <%= values?.bairro === 'Farol' ? 'selected' : '' %>>Farol</option>
            </select>
        </div>

        <div class="card-date">
            <label for="date">Data de Registro<span class="right">*</span></label>
            <input type="date" name ="date" id="date" value="<%= values ? values.data : '' %>">
        </div>
    </div>
</div>
<label for="avaliacao">Avaliação<span class="right">*</span></label>
<small class="right">*campo obrigatório</small>
<div class="star-rating">
    <input type="radio" id="star5" name="rating" value="5" <%= values && values.avaliacao == 5 ? 'checked' : '' %>><label for="star5">★</label>
    <input type="radio" id="star4" name="rating" value="4" <%= values && values.avaliacao == 4 ? 'checked' : '' %>><label for="star4">★</label>
    <input type="radio" id="star3" name="rating" value="3" <%= values && values.avaliacao == 3 ? 'checked' : '' %>><label for="star3">★</label>
    <input type="radio" id="star2" name="rating" value="2" <%= values && values.avaliacao == 2 ? 'checked' : '' %>><label for="star2">★</label>
    <input type="radio" id="star1" name="rating" value="1" <%= values && values.avaliacao == 1 ? 'checked' : '' %>><label for="star1">★</label>
</div>
<div class="card-message">
    <!-- <label for="message">Mensagem</label> -->
    <textarea name="message" id="message" placeholder="Deixe uma mensagem"><%= values?.mensagem || '' %></textarea>
</div>
<div class="espaco-dos-botoes">
    <button type="button" class="botao-voltar" onclick="voltarPaginaCadastrarLocal()" aria-label="Botão Voltar">⬅ Voltar</button>                          
    <button type="submit">Enviar</button>
</div>