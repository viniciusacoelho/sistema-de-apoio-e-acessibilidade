<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/servicos.css">
    <link rel="stylesheet" href="/css/botoes-voltar-e-avancar.css">
</head>
<body>
    <header class="header-index">
        <%- include('partials/navbar') %>
    </header>

    <main>
        <!-- <section class="titulo-e-texto-inclusoes">
            <h1>Inclusões</h1>
            <label for="searchInput">
                <h2 class="descricao-inclusoes">Lista de lugares inclusivos</h2>
            </label>
        </section> -->
        
        <section class="dados-cadastrais-perfil">
            <h1>Dados Cadastrais</h1>
            <hr class="hr-dados-cadastrais-perfil">
            <br>
            <h2>Nome:</h4>
            <%- user.nome %>
            <hr>
            <br>
            <h2>E-mail:</h4>
            <%- user.email %>
            <!-- <hr>
            <br>
            <h2>Data de Criação:</h4>
            <%- user.createdAt %>
            <hr> -->
        </section>

        <section>
            <div class="minhas-inclusoes-perfil">
                <h1>Minhas Inclusões</h1>
                <hr>
            </div>
            <div class="container-notificacoes">
                <% if (inclusoes.length === 0) { %>
                    <div class="alert not-found">
                        <p>Nenhuma inclusão cadastrada.</p>
                    </div>
                <% } %>
                
                <% inclusoes.forEach((inclusao) => { %>
                    <a href="/listagem-inclusoes/<%= inclusao._id %>" class="card-link">
                        <div class="card-inclusao">
                            <img src="<%= inclusao.imagem %>" alt="Imagem do inclusao">
                            
                            <div class="card-conteudo">
                                <h2><%= inclusao.nome %></h3>
                                <h3><%= inclusao.bairro %></h3>
                                <span class="data"><%= inclusao.data %></span>
                                <div class="star-view">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <span class="<%= i <= inclusao.avaliacao ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <p><%= inclusao.mensagem %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>

        <section>
            <div class="minhas-notificacoes-perfil">
                <h1>Minhas Notificações</h1>
                <hr>
            </div>

            
            <div class="container-notificacoes">
                <% if (notificacoes.length === 0) { %>
                    <div class="alert not-found">
                        <p>Nenhuma notificação cadastrada.</p>
                    </div>
                <% } %>

                <% notificacoes.forEach((notificacao) => { %>
                    <a href="/listagem-notificacoes/<%= notificacao._id %>" class="card-link">
                        <div class="card-notificacao">
                            <img src="<%= notificacao.imagem %>" alt="Imagem do local">
    
                            <div class="card-conteudo">
                                <h2><%= notificacao.nome %></h3>
                                <h3><%= notificacao.data %></h3>
                                <span class="data"><%= notificacao.data %></span>
                                <div class="star-view">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <span class="<%= i <= notificacao.avaliacao ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <p><%= notificacao.mensagem %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>
    </main>
    <div class="nav-botoes">
        <button class="botao-voltar" onclick="voltarPaginaListagem()" aria-label="Botão Voltar">⬅ Voltar</button>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/botoes-voltar-e-avancar.js"></script>

</body>
</html>