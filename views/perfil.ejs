<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/servicos.css">
</head>
<body>
    <header class="header-index">
        <%- include('partials/navbar') %>
    </header>

    <main>
        <!-- <section class="titulo-e-texto-inclusoes">
            <h1>Inclusões</h1>
            <label for="searchInput">
                <h2 class="descricao-inclusoes">Lista de lugares inclusivos</h2>
            </label>
        </section> -->
        
        <section>
            <%- user.nome %>
            <br>
            <%- user.email %>
            <br>
            <%- user.createdAt %>
        </section>

        <section>
            <div class="container-notificacoes">
                <% inclusoes.forEach((inclusao) => { %>
                    <a href="/listagem-inclusoes/<%= inclusao._id %>" class="card-link">
                        <div class="card-inclusao">
                            <img src="<%= inclusao.imagem %>" alt="Imagem do inclusao">
                            
                            <div class="card-conteudo">
                                <h3><%= inclusao.nome %></h3>
                                <h3><%= inclusao.bairro %></h3>
                                <span class="data"><%= inclusao.data %></span>
                                <div class="star-view">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <span class="<%= i <= inclusao.avaliacao ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <p><%= inclusao.mensagem %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>

        <section>
            <div class="container-notificacoes">
                <% notificacoes.forEach((notificacao) => { %>
                    <a href="/listagem-notificacoes/<%= notificacao._id %>" class="card-link">
                        <div class="card-notificacao">
                            <img src="<%= notificacao.imagem %>" alt="Imagem do local">
    
                            <div class="card-conteudo">
                                <h3><%= notificacao.nome %></h3>
                                <h3><%= notificacao.data %></h3>
                                <span class="data"><%= notificacao.data %></span>
                                <div class="star-view">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <span class="<%= i <= notificacao.avaliacao ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <p><%= notificacao.mensagem %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/buscar-locais.js"></script>
    <script src="/js/botoes-voltar-e-avancar.js"></script>

</body>
</html>