<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listagem Notificações</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/servicos.css">
</head>
<body>
    <header class="header-index">
        <%- include('partials/navbar') %>
    </header>

    <main>
        <section class="titulo-e-texto-inclusoes">
            <h1>Inclusões</h1>
            <label for="searchInput">
                <h2 class="descricao-inclusoes">Lista de lugares inclusivos</h2>
            </label>
        </section>
        
        <section class="container-textos-e-botoes">
            <div class="search-box">
                <button class="btn-voltar" aria-label="Voltar para página anterior" onclick="voltarPaginaListagem()">← Voltar</button>
                <input type="text" placeholder="Buscar inclusões..." class="search" id="searchInput" title="Clique na tecla / para pesquisar">
                <button onclick="buscar()" class="btn-buscar">Buscar</button>
            </div>

            <p class="contador">
                <strong>Total</strong>: 
                <span class="span-contador-inclusoes">
                    <%= inclusoes.length %>
                </span> inclusões registradas
            </p>
        </section>

        <section>
            <div class="container-notificacoes" title="Clique para ver mais sobre o local">
                <% inclusoes.forEach((inclusao) => { %>
                    <a href="/listagem-inclusoes/<%= inclusao._id %>" class="card-link">
                        <div class="card-inclusao">
                            <img src="<%= inclusao.imagem %>" alt="Imagem do local">
                            
                            <div class="card-conteudo">
                                <h3><%= inclusao.nome %></h3>
                                <h3><%= inclusao.bairro %></h3>
                                <span class="data"><%= inclusao.data %></span>
                                <div class="star-view">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <span class="<%= i <= inclusao.avaliacao ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <p><%= inclusao.mensagem %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    
    <script src="js/buscar-locais.js"></script>
    <script src="js/botoes-voltar-e-avancar.js"></script>

</body>
</html>