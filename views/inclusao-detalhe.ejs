<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= inclusao.nome %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/servicos.css">
    <link rel="stylesheet" href="/css/botoes-voltar-e-avancar.css">
</head>
<body>
    <header class="header-index">
        <%- include('partials/navbar') %>
    </header>

    <main>
        <div class="leia-mais-sobre-inclusao">
            <section>
                <div class="visualizar-local">
                    <div class="visualizar-local-img">

                        <img src="<%= inclusao.imagem %>" alt="Imagem do local">
                    </div>
                    <div class="visualizar-local-card-conteudo">
                        <h3><%= inclusao.nome %></h3>
                        <h3><%= inclusao.bairro %></h3>
                        <span class="data"><%= inclusao.data %></span>
                        <div class="star-view">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <span class="<%= i <= inclusao.avaliacao ? 'filled' : '' %>">★</span>
                            <% } %>
                        </div>
                        <p><%= inclusao.mensagem %></p>
                    </div>
                </div>
            </section>
        </div>

        <% if (user && inclusao.idUsuario && inclusao.idUsuario.toString() === user.id.toString()) { %>
            <div id="nav-botoes-inclusao-detalhe" class="nav-botoes">
                <a href="/inclusao/editar/<%= inclusao._id %>">

                    <button id="botao-editar-inclusao-detalhe" class="botao-voltar" aria-label="Botão Voltar">
                        <i id="icone-perfil" class="fa-solid fa-pen-to-square" aria-label="Editar informações"></i>                    
                        Editar
                    </button>

                </a>
                <form action="/inclusao/deletar/<%= inclusao._id %>" method="post">

                    <button type="button" id="botao-excluir-inclusao-detalhe" class="botao-voltar" aria-label="Botão Voltar">
                        <i id="icone-perfil" class="fa-solid fa-trash-can" aria-label="Excluir item"></i>
                        Excluir
                    </button>

                    <div id="modalExcluir" class="modal-excluir">
                        <div class="modal-conteudo">
                            <h2>Excluir inclusão</h2>
                            <p>Tem certeza que deseja excluir esta inclusão?</p>
                            <div class="modal-botoes">
                                <button type="button" id="cancelarExcluir">Cancelar</button>
                                <button type="submit" id="confirmarExcluir">Excluir</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div> 
        <% } %>
       
        <div class="nav-botoes">
            <button class="botao-voltar" onclick="voltarPaginaListagem()" aria-label="Botão Voltar">⬅ Voltar</button>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/buscar-locais.js"></script>
    <script src="/js/botoes-voltar-e-avancar.js"></script>
    <script src="/js/modal-excluir.js"></script>

</body>
</html>