<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Conheça os serviços do Sistema de Apoio e Acessibilidade (S.A.A.), incluindo busca de locais acessíveis, cadastro e registro de denúncias.">
    <title>Serviços</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/servicos.css">
    <link rel="shortcut icon" href="/images/SAA_logo_editada.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/botoes-voltar-e-avancar.css">
</head>
<body>
    <header class="header-index">
        <%- include('partials/navbar') %>
    </header>
    
    <!-- BOTÃO -->
    <%- include('partials/botao-hamburguer') %>

    <!-- SIDEBAR -->
    <div id="sidebar" class="sidebar">
        <h2>Início</h2>
        <ul>
            <li><a href="#nossos-servicos">Nossos Serviços</a></li>
            <li><a href="#servicos">Os serviços</a></li>
        </ul>
        <h2>Links Externos</h2>
        <ul>
            <li><a href="/acessibilidade">Acessibilidade</a></li>
        </ul>
    </div>

    <main>
        <section>
            <article id="nossos-servicos" class="service">
                <div class="service-description">
                    <h1 class="title-service">Nossos Serviços</h1>

                    <hr>

                    <p class="phrase-service">
                        O Sistema de Apoio e Acessibilidade (S.A.A.) foi desenvolvido para oferecer soluções práticas que auxiliam na promoção da inclusão e na melhoria da acessibilidade urbana. A plataforma reúne funcionalidades que permitem aos usuários acessar informações relevantes, contribuir com a comunidade e participar ativamente da construção de ambientes mais acessíveis. Por meio de recursos simples e eficientes, o sistema busca facilitar o dia a dia das pessoas, promovendo autonomia, segurança e participação social. A seguir, conheça os principais serviços oferecidos pela plataforma:
                    </p>
                </div>
            </article>
        </section>

        <section>

            <div class="cards">
                <a href="/inclusao" class="card-link">
                    <div class="card">
                        <div class="card-icon">
                            <i class="fa-solid fa-circle-plus" aria-label="Cadastrar inclusão" role="img"></i>
                        </div>
                        <div class="card-body">
                            <h2>Cadastrar Inclusão</h2>
                            <p>Cadastre novos locais acessíveis e ajude outras pessoas.</p>
                        </div>
                    </div>
                </a>
    
                <a href="/listagem-inclusoes" class="card-link">
                    <div class="card">
                        <div class="card-icon">
                            <i class="fa-solid fa-map-location-dot" aria-label="Listar lugares inclusivos" role="img"></i>
                        </div>
                        <div class="card-body">
                            <h2>Lugares Inclusivos</h2>
                            <p>Veja locais acessíveis cadastrados pela comunidade.</p>
                        </div>
                    </div>
                </a>
    
                <a href="/notificacao" class="card-link">
                    <div class="card">    
                        <div class="card-icon">
                            <i class="fa-solid fa-triangle-exclamation" aria-label="Reportar lugar" role="img"></i>
                        </div>
                        <div class="card-body">
                            <h2>Reportar Lugar</h2>
                            <p>Informe problemas de acessibilidade encontrados em locais.</p>
                        </div>
                    </div>
                </a>
    
                <a href="/listagem-notificacoes" class="card-link">
                    <div class="card">    
                        <div class="card-icon">
                            <i class="fa-solid fa-clipboard-list" aria-label="Listar lugares reportados" role="img"></i>
                        </div>
                        <div class="card-body">
                            <h2>Lugares Reportados</h2>
                            <p>Consulte locais que possuem denúncias ou problemas reportados.</p>
                        </div>
                    </div>
                </a>
            </div>
        </section>

    </main>
    
    <div class="nav-botoes">
        <button class="botao-voltar" onclick="voltarPaginaServicos()" aria-label="Botão Voltar">⬅ Voltar</button>
        <button class="botao-avancar" onclick="avancarPaginaServicos()" aria-label="Botão Avançar">Avançar ➡</button>
    </div>
    
    <%- include('partials/footer') %>
    
    <script src="js/botoes-voltar-e-avancar.js"></script>
    <script src="js/sidebar.js"></script>
</body>
</html>